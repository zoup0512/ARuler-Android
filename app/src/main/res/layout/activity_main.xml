<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ar_placeholder">

    <android.opengl.GLSurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.aruler.android.ui.MeasurementLabelView
        android:id="@+id/label_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:layout_gravity="top"
        android:background="@drawable/bg_header">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/help_button"
            android:layout_width="@dimen/header_icon"
            android:layout_height="@dimen/header_icon"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/header_side_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/help"
            android:padding="8dp"
            android:src="@drawable/ic_help"
            app:tint="@color/text_title" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/distance_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="72dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/header_placeholder"
            android:textColor="@color/text_title"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="36sp"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/settings_button"
            android:layout_width="@dimen/header_icon"
            android:layout_height="@dimen/header_icon"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/header_side_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_title" />
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/debug_button"
        android:layout_width="@dimen/side_button_size"
        android:layout_height="@dimen/side_button_size"
        android:layout_gravity="start|top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="104dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/debug_visuals"
        android:padding="8dp"
        android:src="@drawable/ic_debug"
        android:visibility="gone"
        app:tint="@color/text_title" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/indicator"
        android:layout_width="@dimen/indicator_size"
        android:layout_height="@dimen/indicator_size"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_indicator"
        app:tint="@color/alert" />

    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/bottom_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/reset_button"
            android:layout_width="@dimen/side_button_size"
            android:layout_height="@dimen/side_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reset_measurement"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_restart" />

        <ImageButton
            android:id="@+id/place_button"
            android:layout_width="@dimen/place_button_size"
            android:layout_height="@dimen/place_button_size"
            android:layout_marginStart="@dimen/action_gap"
            android:alpha="0.5"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/place_point"
            android:enabled="false"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add_place" />

        <ImageButton
            android:id="@+id/trash_button"
            android:layout_width="@dimen/side_button_size"
            android:layout_height="@dimen/side_button_size"
            android:layout_marginStart="@dimen/action_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_measurement"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_trash" />
    </LinearLayout>

    <com.aruler.android.ui.HudView
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/permission_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/camera_permission_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/camera_permission_message"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grant_camera_button"
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/grant_camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_settings_button"
                style="@style/LinkButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_settings"
                android:textColor="@color/white" />
        </LinearLayout>
    </FrameLayout>

    <com.aruler.android.ui.CoachMarkOverlayView
        android:id="@+id/coach_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
