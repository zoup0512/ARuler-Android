<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/donate_note"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_qr_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/wechat_qr"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:contentDescription="@string/donate_wechat"
                    android:scaleType="fitCenter"
                    android:src="@drawable/qr_wechat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/donate_qr_hint"
                    android:textColor="@color/header_text"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wechat_button"
                    style="@style/PrimaryButton"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/donate_wechat" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_qr_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/alipay_qr"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:contentDescription="@string/donate_alipay"
                    android:scaleType="fitCenter"
                    android:src="@drawable/qr_alipay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/donate_qr_hint"
                    android:textColor="@color/header_text"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alipay_button"
                    style="@style/PrimaryButton"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/donate_alipay" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
