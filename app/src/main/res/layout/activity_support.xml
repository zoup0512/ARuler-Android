<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_aruler" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="40dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/support_header"
                android:textColor="@color/header_text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/row_background"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_review"
                    layout="@layout/view_plain_row"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_share"
                    layout="@layout/view_plain_row"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_star"
                    layout="@layout/view_plain_row"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_donate"
                    layout="@layout/view_plain_row"
                    android:layout_width="match_parent"
                    android:layout_height="52dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
