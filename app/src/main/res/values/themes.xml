<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ARuler" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/theme</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/theme</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.ARuler.Main" parent="Theme.ARuler">
        <item name="android:windowBackground">@color/ar_placeholder</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_title</item>
    </style>

    <style name="SectionHeader">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/header_text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">@dimen/section_header_top</item>
        <item name="android:paddingBottom">@dimen/section_header_bottom</item>
    </style>

    <style name="PageBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <style name="PageQuestion">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/theme</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LinkButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/theme</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
